# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000

API_ENDPOINT=api_direction

# Backend origin serving GET /v1/mars-terrain/{seed} for production builds,
# e.g. https://api.example (the Go server's ALLOWED_ORIGINS must allow this
# client's origin), or / when a reverse proxy serves that route on the client's
# own origin. Leave empty for procedural terrain only. Development ignores it
# unless set and uses the Vite proxy to localhost:8080.
VITE_MARS_TERRAIN_API_URL=